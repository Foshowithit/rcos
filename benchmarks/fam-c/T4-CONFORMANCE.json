  "fam04": {"t4_semantic_id": "fam04.promised_acyclic",
            "limitation_predicates": [["acyclic"], ["acyclicity"], ["dag"], ["topological"]]},
  "fam05": {"t4_semantic_id": "fam05.local_v1_sha256",
            "limitation_predicates": [["local", "sha256"], ["v1", "sha256"], ["local", "v1"], ["sha256", "basis"]]},
  "fam06": {"t4_semantic_id": "fam06.common_unit_basis",
