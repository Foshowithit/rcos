#!/usr/bin/env node
'use strict';

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const R = require('../lib/registry');
const T = require('../lib/traces');
const { isValidDate } = require('../lib/validate');
const { renderDashboard } = require('../lib/render');

const USAGE = [
  'usage: rcos <command> [options]',
  '',
  '  query [--status S] [--kind K] [--json]',
  '  propose --id <id> --name <name> --kind <kind> [--version x.y.z] [--lineage <text>]',
  '  eval-submit --id <id> --task <task> --verdict ship|fix|blocked --run <run> [--date YYYY-MM-DD]',
  '              [--context <text>] [--source reuse|synthesize] [--seconds <n>]',
  '  traces [--capability <id>] [--json]',
  '  backfill-traces',
  '  promote --id <id>',
  '  retire --id <id> --reason <text>',
  '  reuse --id <id>',
  '  audit [--json]',
  '  render [--out <path>]',
  '  help'
].join('\n');

function homeDir() {
  return process.env.RCOS_HOME || path.join(os.homedir(), 'zcode-rcos');
}

function parseArgs(argv) {
  const args = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith('--')) { console.error('unexpected argument: ' + a + '\n' + USAGE); process.exit(1); }
    const key = a.slice(2);
    const next = argv[i + 1];
    if (next === undefined || next.startsWith('--')) args[key] = true;
    else { args[key] = next; i++; }
  }
  return args;
}

function need(args, ...keys) {
  for (const k of keys) {
    if (args[k] === undefined || args[k] === true) {
      console.error('missing required --' + k + '\n' + USAGE);
      process.exit(1);
    }
  }
}

function main() {
  const cmd = process.argv[2];
  const args = parseArgs(process.argv.slice(3));
  const home = homeDir();
  if (!cmd || cmd === 'help') { console.log(USAGE); process.exit(cmd ? 0 : 1); }
  try {
    switch (cmd) {
      case 'query': {
        const reg = R.loadRegistry(home);
        const rows = R.queryCapabilities(reg, { status: args.status, kind: args.kind });
        if (args.json) { console.log(JSON.stringify(rows, null, 2)); break; }
        if (rows.length === 0) { console.log('no capabilities match'); break; }
        for (const c of rows) {
          console.log([c.status, c.kind, c.id, c.name, 'v' + c.version, 'reuse=' + c.reuse_count, 'last=' + (c.last_eval === null ? '-' : c.last_eval)].join('\t'));
        }
        break;
      }
      case 'propose': {
        need(args, 'id', 'name', 'kind');
        const reg = R.loadRegistry(home);
        R.proposeCapability(reg, { id: args.id, name: args.name, kind: args.kind, version: args.version, lineage: args.lineage });
        R.saveRegistry(home, reg);
        console.log('proposed \'' + args.id + '\' as candidate');
        break;
      }
      case 'eval-submit': {
        need(args, 'id', 'task', 'verdict', 'run');
        if (args.date && !isValidDate(args.date)) { console.error('bad --date, want YYYY-MM-DD'); process.exit(1); }
        const reg = R.loadRegistry(home);
        R.submitEval(reg, args.id, { task_id: args.task, verdict: args.verdict, run_id: args.run, date: args.date });
        // trace first: if the append fails the registry is not mutated, so the
        // two can never silently diverge (a trace line per eval is invariant)
        T.appendTrace(home, {
          capability: args.id, task_id: args.task, verdict: args.verdict,
          context: args.context === true ? undefined : args.context,
          source: args.source === true ? undefined : args.source,
          seconds: args.seconds === true || args.seconds === undefined ? undefined : Number(args.seconds),
          date: args.date || undefined
        });
        R.saveRegistry(home, reg);
        console.log('recorded ' + args.verdict + ' for \'' + args.id + '\' on ' + args.task + ' (+trace)');
        break;
      }
      case 'traces': {
        let rows = T.loadTraces(home);
        if (args.capability) rows = rows.filter((t) => t.capability === args.capability);
        if (args.json) { console.log(JSON.stringify(rows, null, 2)); break; }
        console.log('traces: ' + rows.length + (args.capability ? ' for \'' + args.capability + '\'' : ' total') +
          ' (' + rows.filter((t) => t.context !== null).length + ' with context, ' +
          rows.filter((t) => !t.backfilled).length + ' live)');
        for (const t of rows.slice(-10)) {
          console.log([t.date || t.ts.slice(0, 10), t.capability, t.task_id, t.verdict,
            t.source || '-', t.context ? String(t.context).slice(0, 60) : '-'].join('\t'));
        }
        break;
      }
      case 'backfill-traces': {
        const reg = R.loadRegistry(home);
        const traces = T.loadTraces(home);
        const gaps = T.traceGaps(reg, traces);
        if (gaps.length === 0) { console.log('no trace gaps — every eval already has a trace line'); break; }
        for (const c of reg.capabilities) {
          for (const e of c.evals) {
            T.appendTrace(home, {
              capability: c.id, task_id: e.task_id, verdict: e.verdict,
              backfilled: true
            });
          }
        }
        console.log('backfilled ' + gaps.length + ' trace line(s), flagged backfilled:true');
        break;
      }
      case 'promote': {
        need(args, 'id');
        const reg = R.loadRegistry(home);
        const dir = path.join(home, 'capabilities', args.id);
        if (!fs.existsSync(path.join(dir, 'EVAL.json'))) {
          console.error('rcos: cannot promote \'' + args.id + '\': capabilities/' + args.id + '/EVAL.json missing — document the eval before promoting');
          process.exit(2);
        }
        R.promoteCapability(reg, args.id);
        R.saveRegistry(home, reg);
        console.log('promoted \'' + args.id + '\'');
        break;
      }
      case 'retire': {
        need(args, 'id', 'reason');
        const reg = R.loadRegistry(home);
        R.retireCapability(reg, args.id, args.reason);
        R.saveRegistry(home, reg);
        console.log('retired \'' + args.id + '\'');
        break;
      }
      case 'reuse': {
        need(args, 'id');
        const reg = R.loadRegistry(home);
        const cap = R.logReuse(reg, args.id);
        R.saveRegistry(home, reg);
        console.log('\'' + args.id + '\' reuse_count=' + cap.reuse_count);
        break;
      }
      case 'audit': {
        const reg = R.loadRegistry(home);
        const res = R.auditRegistry(reg);
        for (const g of T.traceGaps(reg, T.loadTraces(home))) res.warnings.push('trace gap: ' + g);
        if (args.json) console.log(JSON.stringify(res, null, 2));
        else {
          for (const e of res.errors) console.log('ERROR ' + e);
          for (const w of res.warnings) console.log('WARN ' + w);
          console.log(res.ok ? 'audit clean' : 'audit FAILED');
        }
        if (!res.ok) process.exit(2);
        break;
      }
      case 'render': {
        const reg = R.loadRegistry(home);
        const out = args.out || path.join(home, 'dashboard.html');
        fs.writeFileSync(out, renderDashboard(reg));
        console.log('wrote ' + out);
        break;
      }
      default: {
        console.error('unknown command: ' + cmd + '\n' + USAGE);
        process.exit(1);
      }
    }
  } catch (err) {
    console.error('rcos: ' + err.message);
    process.exit(2);
  }
}

main();
