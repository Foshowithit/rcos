# .env.example — PLACEHOLDER VALUES ONLY. Never commit a filled `.env`.
# Copy to `.env` (git-ignored) and point at YOUR OWN checkouts. No secrets here, ever.

# Your Pi checkout (AgentSpecs in <pi>/agents, lanes in <pi>/models.json)
PI_CHECKOUT=/path/to/your/pi-checkout

# Your DSH checkout (settings.yaml, agent-specs/)
DSH_CHECKOUT=/path/to/your/dsh-checkout

# Your Archon checkout + workflow library dir
ARCHON_CHECKOUT=/path/to/your/archon-checkout
ARCHON_WORKFLOWS=/path/to/your/archon-checkout/workflows

# Where run artifact dirs go (default ./runs, git-ignored)
RCOS_RUN_DIR=./runs

# Model lane id for model nodes, e.g. provider/model from your own models.json.
# Must resolve to a subscription/funded lane you already own. Do NOT add keys here.
RCOS_MODEL=provider/model
