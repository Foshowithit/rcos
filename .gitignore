# Secrets + local state — never committed
.env
*.env
runs/
# Exception: slice-0 audited evidence IS committed (auditor must reconstruct runs)
!slices/v0-validated-reuse/runs/
!slices/v0-validated-reuse/runs/**
# Exception: slice-1 audited evidence IS committed (same reason)
!slices/v1-portable-reuse/runs/
!slices/v1-portable-reuse/runs/**
# Exception: slice-3 audited evidence IS committed (arm outputs, correct-arm
# records, and the forced-incident correction only — not harness scripts,
# quarantine, or pycache)
!slices/v3-crossmodel/runs/
!slices/v3-crossmodel/runs/arm-h*.json
!slices/v3-crossmodel/runs/rec-h*.json
!slices/v3-crossmodel/runs/forced-incident/
!slices/v3-crossmodel/runs/forced-incident/**
*.log

# Credentials / vaults / auth (belt and suspenders — these must NEVER appear in history)
*credentials*.yaml
*credentials*.yml
*credentials*.json
auth.json
.agent-vault/
.dsh/
.pi/
.archon/
**/.agent-vault/
**/auth.json

# API keys / tokens / private keys by pattern
*.pem
*.key
id_rsa*
id_ed25519*
*_TOKEN*
*_SECRET*

# Large artifacts
*.mp4
*.mov
*.blend
*.ckpt
*.pt
*.bin
node_modules/
__pycache__/
*.pyc
.DS_Store
